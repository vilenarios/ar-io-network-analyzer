# /etc/ario-portal-api/testnet.env — root-owned, chmod 0600.
#
# SOLANA_RPC_URL carries a provider token. It must be an endpoint WITHOUT a
# referrer allowlist: this is a server process, it sends no browser Referer,
# and @solana/kit refuses to set one (it enforces the browser forbidden-header
# list even in Node). Protect it with an IP allowlist instead.
#
# Do NOT reuse the endpoint the portal ships in its browser bundle. That one is
# public by necessity; this one is a real secret.
SOLANA_RPC_URL=https://<endpoint>.solana-devnet.quiknode.pro/<token>/

# REQUIRED. The publisher will refuse to start without it unless the endpoint
# host literally contains a cluster name.
#
# It is not merely a hint: the network portal rejects any document whose
# `network` disagrees with its own inference, and its inference falls back to
# "mainnet" where this one would fall back to "unknown". An endpoint that hides
# its cluster — an internal resolver, a vanity domain, or QuickNode domain
# masking — would therefore publish "unknown", have every document silently
# refused, and keep reporting success. Set it explicitly.
PORTAL_NETWORK=devnet

# Where documents are published. nginx serves this directory directly.
PUBLIC_DIR=/var/lib/ario-portal-api/testnet/public

# /healthz only; nginx serves the documents.
PORT=8788
HOST=127.0.0.1

# Publish cadence. 144 whole-program scans per document per day.
PORTAL_POLL_INTERVAL_MS=600000

# Age beyond which /healthz reports the snapshot stale. Defaults to 2.5 cycles.
PORTAL_MAX_AGE_SECONDS=1500
