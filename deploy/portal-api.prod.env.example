# /etc/ario-portal-api/prod.env — root-owned, chmod 0600.
#
# SOLANA_RPC_URL carries a provider token. It must be an endpoint WITHOUT a
# referrer allowlist: this is a server process, it sends no browser Referer,
# and @solana/kit refuses to set one (it enforces the browser forbidden-header
# list even in Node). Protect it with an IP allowlist instead.
#
# Do NOT reuse the endpoint the portal ships in its browser bundle. That one is
# public by necessity; this one is a real secret.
SOLANA_RPC_URL=https://<endpoint>.solana-mainnet.quiknode.pro/<token>/

# Optional. Inferred from the endpoint host when unset.
PORTAL_NETWORK=mainnet

# Where documents are published. nginx serves this directory directly.
PUBLIC_DIR=/var/lib/ario-portal-api/prod/public

# /healthz only; nginx serves the documents.
PORT=8787
HOST=127.0.0.1

# Publish cadence. 144 whole-program scans per document per day.
PORTAL_POLL_INTERVAL_MS=600000

# Age beyond which /healthz reports the snapshot stale. Defaults to 2.5 cycles.
PORTAL_MAX_AGE_SECONDS=1500
