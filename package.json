{
  "name": "ar-io-network-analyzer",
  "version": "0.0.1",
  "description": "Basic scripts to analyze AR.IO Network centralization patterns to identify potential same-actor gateways",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vilenarios/ar-io-network-analyzer.git"
  },
  "homepage": "https://github.com/vilenarios/ar-io-network-analyzer#readme",
  "bugs": {
    "url": "https://github.com/vilenarios/ar-io-network-analyzer/issues"
  },
  "scripts": {
    "analyze": "tsx --env-file-if-exists=.env src/index.ts",
    "analyze:demo": "cross-env USE_DEMO_DATA=true tsx --env-file-if-exists=.env src/index.ts",
    "analyze:fast": "cross-env ANALYZE_PERFORMANCE=false tsx --env-file-if-exists=.env src/index.ts",
    "analyze:arweave": "tsx --env-file-if-exists=.env src/arweave/arweave-index.ts",
    "analyze:arweave:demo": "cross-env USE_DEMO_DATA=true tsx --env-file-if-exists=.env src/arweave/arweave-index.ts",
    "build": "tsc",
    "clean": "rimraf dist *.csv *.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src test --ext .ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "capture": "tsx --env-file-if-exists=.env src/capture/daemon.ts",
    "capture:once": "tsx --env-file-if-exists=.env src/capture/daemon.ts --once",
    "capture:status": "tsx --env-file-if-exists=.env src/capture/daemon.ts --status",
    "observers:findings": "tsx --env-file-if-exists=.env src/observers/run-findings.ts",
    "observers:calibrate": "tsx --env-file-if-exists=.env src/observers/calibrate.ts",
    "observers:backfill": "tsx --env-file-if-exists=.env src/observers/run-findings.ts --all-epochs",
    "serve": "tsx --env-file-if-exists=.env src/server/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrations.ts --apply",
    "db:stats": "tsx --env-file-if-exists=.env src/db/migrations.ts --stats",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "ar.io",
    "arweave",
    "gateway",
    "analysis",
    "centralization"
  ],
  "author": "Vilenarios",
  "license": "MIT",
  "dependencies": {
    "@ar.io/sdk": "4.0.2",
    "@solana/kit": "^6.8.0",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
