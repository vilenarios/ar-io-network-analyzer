# AR.IO Gateway Analyzer Configuration

# AR.IO Process ID (default: mainnet)
ARIO_PROCESS_ID=qNvAoz0TgcH7DMg8BCVn8jF32QH5L6T29VjHxhHqqGE

# Use demo data instead of real network
USE_DEMO_DATA=false

# Enable performance analysis (makes HTTP requests to gateways)
ANALYZE_PERFORMANCE=false

# Minimum stake threshold
MIN_STAKE=10000

# AO Network Configuration (optional)
# AO_CU_URL=https://cu.ao-testnet.xyz
# AO_MU_URL=https://mu.ao-testnet.xyz
# AO_GATEWAY_URL=https://arweave.net
# AO_GRAPHQL_URL=https://arweave.net/graphql

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------
# Endpoint for every on-chain read. It MAY carry a provider token, so it is
# never logged, never written to the database, and never published — only its
# host is ever printed. Defaults to the SDK's MAINNET_RPC_URL when unset.
# SOLANA_RPC_URL=<redacted>

# Delay between gateway pages during the daily analysis (ms)
# SOLANA_PAGE_DELAY_MS=500

# ---------------------------------------------------------------------------
# Observation capture (yarn capture)
# ---------------------------------------------------------------------------
# Shared SQLite file. Irreplaceable: Observation accounts are swept off the
# chain within days and cannot be backfilled.
# OBSERVER_DB_PATH=data/observations.sqlite

# Poll interval in ms (default 10 minutes)
# OBSERVER_POLL_INTERVAL_MS=600000

# How long poll_runs bookkeeping is kept (days, default 30). Observations and
# revisions are NEVER pruned — only this run log is.
# POLL_RUN_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Findings (yarn observers:findings)
# ---------------------------------------------------------------------------
# UNCALIBRATED PLACEHOLDER. Until `yarn observers:calibrate --activate <id>`
# has been run, near-identical findings are capped at medium severity and 0.5
# confidence. Do not raise this on intuition — measure first.
# OBSERVER_SIMILARITY_THRESHOLD=0.90

# Rolling window of epochs the detectors consider
# OBSERVER_WINDOW_EPOCHS=30

# Co-submission window in seconds
# OBSERVER_CO_SUBMISSION_WINDOW_S=60

# ---------------------------------------------------------------------------
# Publishing and serving
# ---------------------------------------------------------------------------
# PUBLIC_DIR=public
# PORT=8787
# HOST=127.0.0.1

# Age beyond which the published analysis counts as stale (seconds, default 48h)
# ANALYSIS_MAX_AGE_SECONDS=172800

# Age beyond which capture counts as stale (seconds, default 1h)
# CAPTURE_MAX_AGE_SECONDS=3600
# ---------------------------------------------------------------------------
# Portal snapshot API (yarn portal)
# ---------------------------------------------------------------------------
# Publishes the whole-program scans the network portal would otherwise run in
# every visitor's browser. See docs/portal-api.md.
#
# IMPORTANT: SOLANA_RPC_URL for this service must be an endpoint WITHOUT a
# referrer allowlist. This is a server process — it sends no browser Referer,
# and @solana/kit refuses to set one, so a referrer-restricted endpoint returns
# 401 regardless of auth method. Use an IP allowlist instead, and do not reuse
# the endpoint the portal ships in its browser bundle.

# Publish cadence (default 10 minutes).
# PORTAL_POLL_INTERVAL_MS=600000

# Age beyond which /healthz reports the snapshot stale (default: 2.5 cycles).
# PORTAL_MAX_AGE_SECONDS=1500

# Network label on published documents. Inferred from the endpoint when unset.
# PORTAL_NETWORK=mainnet
