{
  "//paths": "moduleResolution 'node' predates export maps, so tsc cannot see @ar.io/solana-contracts' './core' subpath. Node resolves it correctly at runtime; `paths` points the typechecker at the same file. Remove once moduleResolution moves to node16/bundler.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@ar.io/solana-contracts/core": ["node_modules/@ar.io/solana-contracts/lib/core/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}