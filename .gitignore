# Dependencies
node_modules/
.npm

# Build output
dist/
*.js
*.js.map
*.d.ts
*.d.ts.map

# Analysis output
reports/
*.csv
*.json
!package.json
!tsconfig.json
!tsconfig.test.json
# Tooling config that happens to be JSON — the blanket *.json rule above is
# aimed at generated analysis output, not at checked-in configuration.
!.eslintrc.json

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.temp
# Observation capture database (irreplaceable — back it up, do not commit)
# Anchored: an unanchored `data/` would also swallow src/data/.
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Published static tree. The scratch tree is per-process (public.tmp.<pid>),
# so two publishers cannot delete each other's in-flight files.
/public/
/public.tmp*/

# Keep the Node version pin tracked
!.nvmrc
